{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "app.py": {
      "includeFiles": "{data/mock/*.json,frontend/dist/**}",
      "maxDuration": 10
    }
  },
  "outputDirectory": "frontend/dist"
}
